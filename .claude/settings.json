{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(composer *)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(php *)",
      "Read(./.env.example)",
      "Edit(./.env.example)",
      "mcp__laravel-boost*",
      "mcp__chrome-devtools*",
      "mcp__linear-server*"
    ],
    "ask": [
      "Edit(./CLAUDE.md)",
      "Edit(./CLAUDE.project.md)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.claude/agents/**)",
      "Write(./.claude/agents/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./auth.json)"
    ]
  }
}
